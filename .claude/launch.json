{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site-full",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8788
    },
    {
      "name": "site-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "site"
      ],
      "port": 8765
    },
    {
      "name": "vacancy-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--directory",
        "../vacancy-tz-zbirka-mebliv/site"
      ],
      "port": 8790
    }
  ]
}